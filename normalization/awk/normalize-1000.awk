
# 1 000,00 -> 1.000,00
{
	for (i = 1; i <= NF; i++) {
		if ($i ~ /^[0-9]{1,3}$/) {
			buf = $i;
			for (j = i + 1; j <= NF; j++) {
				if ($j ~ /^[0-9]{3}$/ || $j ~ /^[0-9]{3}[,][0-9]+$/) {
					buf = buf "." $j;
				} else {
					j--;
					break;
				}
			}
			if (buf ~ /^([0-9]{1,3}[.])([0-9]{3}[.])*([0-9]{3})([,][0-9]+)?$/) {
				if (i > 1 && $(i-1) ~ /[0-9]$/) continue;
				if (j < NF && $(j+1) ~ /^[,]?[0-9]/) continue;
				for (k = i; k <= j; k++) {
					$k = null;
				}
				$i = buf;
			}
		}
	}
	print;
}
